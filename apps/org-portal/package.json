    "@react-router/fs-routes": "8.5.2",
    "@react-router/node": "8.5.2",
    "@react-router/serve": "8.5.2",
    "@tanstack/react-query": "5.90.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
